{
  "name": "en-equipo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/src/index.js",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "concurrently -k -n API,WEB -c cyan,magenta \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node server/src/index.js",
    "start:web": "next start --hostname 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
